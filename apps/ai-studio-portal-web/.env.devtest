# 指定为生产环境
NODE_ENV = development

# 登录方式-maxkey / own
NUXT_LOGIN_TYPE = 'own'

# 网络请求基础路径
NUXT_API_BASE_URL = 'http://devtest.inspuriip.com:30005/'

# 登录地址
NUXT_LOGIN_URL = 'http://devtest.inspuriip.com:30005/sign/authz/oauth/v20/authorize?client_id=894283562298114048&response_type=code&redirect_uri='

# 登出地址
NUXT_LOGOUT_URL = 'http://devtest.inspuriip.com:30005/sign/force/logout?redirect_uri='

# Token模式
NUXT_TOKEN_TYPE = 'Bearer'

# 项目基础路由
NUXT_APP_BASE_URL = '/cloud-market'
