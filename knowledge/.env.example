NODE_ENV=production
HOST=0.0.0.0
PORT=3000
API_PREFIX=/ai-studio/v1/knowledge

# Local embedding model cache. Keep data/models/Xenova/bge-small-zh-v1.5 on the server
# or allow the service to download it on first startup.
EMBEDDING_MODE=local
EMBEDDING_LOCAL_MODEL=Xenova/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=./data/models
EMBEDDING_DIMENSION=384

VECTOR_STORE=sqlite
VECTOR_STORE_PATH=./data/vectors
DB_PATH=./data/biaoshu.db
KB_INPUT_PATH=./data/kb-input
TESSDATA_PREFIX=./lib/tessdata
