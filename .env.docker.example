# ===== Backend: MySQL =====
SPRING_DATASOURCE_URL=jdbc:mysql://your-mysql-host:3306/your_database?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=your_username
SPRING_DATASOURCE_PASSWORD=your_password

# ===== Backend: JWT / RSA =====
JWT_SECRET=replace-with-a-strong-jwt-secret
JWT_EXPIRATION=86400000
RSA_PRIVATE_KEY=replace-with-your-base64-rsa-private-key
RSA_PUBLIC_KEY=replace-with-your-base64-rsa-public-key

# ===== Backend: OSS =====
OSS_ENDPOINT=https://your-oss-endpoint
OSS_ACCESS_KEY=your_access_key
OSS_SECRET_KEY=your_secret_key
OSS_BUCKET_NAME=your_bucket_name
OSS_DOWNLOAD_URL=https://your-download-domain
OSS_REGION=your_region

# ===== Backend: Mail =====
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ===== Backend: GitLab Activity =====
GITLAB_ACTIVITY_API_BASE_URL=
GITLAB_ACTIVITY_PRIVATE_TOKEN=
GITLAB_ACTIVITY_WEBHOOK_TOKEN=
GITLAB_ACTIVITY_SCHEDULES_ENABLED=false
GITLAB_ACTIVITY_DAILY_ANALYZE_CRON=0 15 20 * * ?
GITLAB_ACTIVITY_DAILY_REPORT_CRON=0 30 20 * * ?
GITLAB_ACTIVITY_BACKFILL_CRON=0 0/30 * * * ?

# ===== Published Ports =====
BACKEND_PORT=8080
ADMIN_PORT=8081
CONSOLE_PORT=8082
PORTAL_PORT=3000

# ===== Portal Runtime (browser-accessible URLs) =====
# Do not use Docker internal hostname here in production.
# Use your real server IP/domain or reverse-proxy address.
NUXT_API_BASE_URL=http://your-domain-or-ip:8080/ai-studio/v1
NUXT_LOGIN_TYPE=own
NUXT_TOKEN_TYPE=Bearer
NUXT_APP_BASE_URL=/
NUXT_CONSOLE_BASE_URL=http://your-domain-or-ip:8082/ai-studio-plus-console-web
NUXT_KNOWLEDGE_API_BASE=http://localhost:3002/ai-studio/v1/knowledge
